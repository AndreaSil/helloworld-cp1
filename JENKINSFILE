pipeline {
    agent any
	options { skipDefaultCheckout(true) }
    stages {
        stage('Get Code') {
            steps {
                git 'https://github.com/AndreaSil/helloworld-cp1.git'
	            
				bat 'whoami'
				bat 'hostname'
				bat 'echo %WORKSPACE%'
			
                bat 'dir'
                stash name:'code', includes:'**'
            }
        }
        
        stage('Tests'){
            parallel {
                stage('Unit') {
					steps {
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
							bat '''
							whoami
							hostname
							echo %WORKSPACE%

							set PYTHONPATH=%WORKSPACE%
							coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
							coverage xml -o coverage.xml
							'''
						}
						junit 'result-unit.xml'
					}
                }
				
				stage('Static') {
				  steps {
					bat '''
					  whoami
					  hostname
					  echo %WORKSPACE%

					  flake8 --exit-zero --format=pylint app >flake8.out
					  type flake8.out
					'''
					recordIssues(
					  tools: [flake8(pattern: 'flake8.out')],
					  qualityGates: [[threshold: 8, type: 'TOTAL', unstable: true],[threshold: 10, type: 'TOTAL', unstable: false]],
					  sourceCodeRetention: 'LAST_BUILD'
					)
				  }
				}
				
				stage('Security') {
				  steps {
					bat '''
					  whoami
					  hostname
					  echo %WORKSPACE%

					  python -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: {severity}: {test_id}: {msg}"
					  type bandit.out
					'''
					recordIssues(
					  tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true],[threshold: 4, type: 'TOTAL', unstable: false]],
					  sourceCodeRetention: 'LAST_BUILD'
					)
				  }
				}
            }
        }

		stage('Service/Rest') {
			steps {
				catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
					bat '''
						whoami
						hostname
						echo %WORKSPACE%

						set FLASK_APP=app\\api.py
						
						REM Arrancar Flask en segundo plano
						start flask run
						
						REM Arrancar WireMock en segundo plano
                        start java -jar "C:\\Users\\andre\\UNIR 2025\\wiremock\\wiremock-jre8-standalone-2.28.0.jar" --port 9090 --root-dir "C:\\Users\\andre\\UNIR 2025\\wiremock"
						
						REM Esperar a que los servicios arranquen
						timeout /t 5 
						
						REM PYTHONPATH
                        set PYTHONPATH=%WORKSPACE%
						
						REM Ejecutar tests REST
						pytest --junitxml=result-rest.xml test\\rest
					'''
				}
				junit 'result-rest.xml'
			}
		}  


		stage('Performance') {
		  steps {
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
			  bat '''
				whoami
				hostname
				echo %WORKSPACE%

				set FLASK_APP=app\\api.py
				
				REM Arrancar Flask en segundo plano
				start flask run
				
				timeout /t 5

				"C:\\Users\\andre\\UNIR 2025\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t test\\jmeter\\flask.jmx -l flask.jtl -j jmeter.log
			  '''
			}
			perfReport sourceDataFiles: 'flask.jtl'
		  }
		}

		stage('Coverage') {
		  steps {
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
			  bat '''
				whoami
				hostname
				echo %WORKSPACE%
				dir coverage.xml
			  '''
			}

			cobertura coberturaReportFile: 'coverage.xml',
					 onlyStable: false,
					 lineCoverageTargets: '95,85,0',
					 conditionalCoverageTargets: '90,80,0'
		  }
		}			
    }
}
