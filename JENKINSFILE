pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                git 'https://github.com/AndreaSil/helloworld-cp1.git'
	            
				bat 'whoami'
				bat 'hostname'
				bat 'echo %WORKSPACE%'
			
                bat 'dir'
                stash name:'code', includes:'**'
            }
        }
        
        stage('Tests')
        {
            parallel
            {
                stage('Unit') {
					steps {
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
							bat '''
							whoami
							hostname
							echo %WORKSPACE%

							set PYTHONPATH=%WORKSPACE%
							coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
							coverage xml -o coverage.xml
							'''
						}
						junit 'result-unit.xml'
					}
                }
                
                stage('Rest') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
								whoami
								hostname
								echo %WORKSPACE%

								set PYTHONPATH=%WORKSPACE%
                                set FLASK_APP=app\\api.py
                                start flask run
                                start java -jar C:\\UNIR\\Ejercicios\\wiremock-jre8-standalone-2.28.0.jar --port 9090 --root-dir test\\wiremock
                                
								timeout /t 10 /nobreak
                                
                                pytest --junitxml=result-rest.xml test\\rest
                            '''
                        }
						junit 'result-rest.xml'
                    }
                }        
            }
        }

		stage('Quality (parallel)') {
			  parallel {
				stage('Unit') {
				  steps {
					catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
					  bat '''
						whoami
						hostname
						echo %WORKSPACE%

						set PYTHONPATH=%WORKSPACE%

						REM Unit + Coverage generation (solo una ejecución)
						coverage run --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit || exit /b 0
						coverage xml -o coverage.xml
					  '''
					}
					junit 'result-unit.xml'
				  }
				}

				stage('Static') {
				  steps {
					catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
					  bat '''
						whoami
						hostname
						echo %WORKSPACE%

						flake8 --format=pylint --exit-zero app > flake8.out
						type flake8.out
					  '''
					}

					recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')], qualityGates: [[threshold: 8,  type: 'TOTAL', unstable: true],[threshold: 10, type: 'TOTAL', unstable: false]]
				  }
				}

				stage('Security Test') {
				  steps {
					catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
					  bat '''
						whoami
						hostname
						echo %WORKSPACE%

						bandit -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: {severity}: {test_id}: {msg}"
						type bandit.out
					  '''
					}

					recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')], qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true],[threshold: 4, type: 'TOTAL', unstable: false]]
				  }
				}
			}
		}		
    }
}
