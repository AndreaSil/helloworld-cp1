pipeline {
    agent any
	options { skipDefaultCheckout(true) }
    stages {
        stage('Get Code') {
            steps {
                git 'https://github.com/AndreaSil/helloworld-cp1.git'
	            
				bat 'whoami'
				bat 'hostname'
				bat 'echo %WORKSPACE%'
			
                bat 'dir'
                stash name:'code', includes:'**'
			}
		}
        
        stage('Tests')
        {
            parallel
            {
                stage('Unit+Coverage') {
                    steps {
						unstash 'code'
						
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            unstash name:'code'
                            bat '''
                                dir
								
								set PYTHONPATH=%WORKSPACE%
								coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
								coverage xml -o coverage.xml
								dir result-unit.xml
								dir coverage.xml
                            '''
						}
					   
					    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  junit testResults: 'result-unit.xml', allowEmptyResults: true
						}
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						   recordCoverage(
							tools: [ [parser: 'COBERTURA', pattern: 'coverage.xml']],
									qualityGates: [
							[criticality: 'NOTE',  metric: 'LINE',   threshold: 95.0],
							[criticality: 'ERROR', metric: 'LINE',   threshold: 85.0],
							[criticality: 'NOTE',  metric: 'BRANCH', threshold: 90.0],
							[criticality: 'ERROR', metric: 'BRANCH', threshold: 80.0]])
						}
					}
				}

			    stage('Static (flake8)') {
                    steps {
                        unstash 'code'
						
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
                                flake8 --exit-zero --format=pylint app 1>flake8.out
                                type flake8.out
                            '''
						}
						
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  recordIssues tools: [flake8(pattern: 'flake8.out')], qualityGates: [[threshold: 8,  type: 'TOTAL', unstable: true ],[threshold: 15, type: 'TOTAL', unstable: false]]
						}
					}
				}
				
				stage('Security (Bandit)') {
                    steps {
						unstash 'code'

                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
                                python -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: {test_id}: {msg}"
                                type bandit.out
                            '''
						}
						
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  recordIssues(
							enabledForFailure: true,
							tools: [pyLint(pattern: 'bandit.out')],qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true],[threshold: 4, type: 'TOTAL', unstable: false]])
						}
					}
				}
			}
        }

		stage('Service/Rest') {
			steps {
				catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
					bat '''
						set FLASK_APP=app\\api.py
						
						REM Arrancar Flask en segundo plano
						start flask run
						
						REM Arrancar WireMock en segundo plano
                        start java -jar "C:\\Users\\andre\\UNIR 2025\\wiremock\\wiremock-jre8-standalone-2.28.0.jar" --port 9090 --root-dir "C:\\Users\\andre\\UNIR 2025\\wiremock"
						
						REM Esperar a que los servicios arranquen
						timeout /t 5 
						
						REM PYTHONPATH
                        set PYTHONPATH=%WORKSPACE%
						
						REM Ejecutar tests REST
						pytest --junitxml=result-rest.xml test\\rest
						
						REM Parar WireMock (solo el proceso que escucha en 9090)
						for /f "tokens=5" %%a in ('netstat -aon ^| findstr :9090 ^| findstr LISTENING') do taskkill /F /PID %%a

						REM Parar Flask (solo el proceso que escucha en 5000)
						for /f "tokens=5" %%a in ('netstat -aon ^| findstr :5000 ^| findstr LISTENING') do taskkill /F /PID %%a
					'''
				}
				catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
				    junit testResults: 'result-rest.xml', allowEmptyResults: true
				}
			}
		}  


		stage('Performance') {
		  steps {
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
			  bat '''
				set FLASK_APP=app\\api.py
				
				REM Arrancar Flask en segundo plano
				start flask run
				
				timeout /t 5

				"C:\\Users\\andre\\UNIR 2025\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t test\\jmeter\\flask.jmx -l flask.jtl -j jmeter.log
			  '''
			}
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                perfReport sourceDataFiles: 'flask.jtl'
			}
		}
    }
  }
  post {
        always {
             bat '''
			  REM Parar WireMock (solo el que escucha en 9090)
			  for /F "tokens=5" %%a in ('netstat -aon ^| findstr :9090 ^| findstr LISTENING') do taskkill /F /PID %%a

			  REM Parar Flask (solo el que escucha en 5000)
			  for /F "tokens=5" %%a in ('netstat -aon ^| findstr :5000 ^| findstr LISTENING') do taskkill /F /PID %%a
			'''
			cleanWs disableDeferredWipeout: true, deleteDirs: true
        }
    }
}