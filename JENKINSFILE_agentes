pipeline {
    agent any

    options { skipDefaultCheckout() }
	//QUE SEA LO QUE DIOS QUIERA ALLA VA
     stages {
        stage('Get Code') {
            steps {
				deleteDir()
				
                git branch: 'master', url: 'https://github.com/AndreaSil/helloworld-cp1.git'
	            
				bat 'whoami'
				bat 'hostname'
				bat 'echo %WORKSPACE%'
			
                bat 'dir'
                stash name:'code', includes:'**'
            }
			post { always { cleanWs() } }
        }
        
        stage('Tests')
        {
            parallel
            {
                stage('Unit+Coverage') {
                    agent {label 'agent1'}
                    steps {
						deleteDir()
						unstash 'code'
						
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            unstash name:'code'
                            bat '''
                                dir
								whoami
                                hostname
                                echo %WORKSPACE%
								
								set PYTHONPATH=%WORKSPACE%
								coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
								coverage xml -o coverage.xml
								dir result-unit.xml
								dir coverage.xml
                            '''
                           // stash name:'unit-res', includes:'result-unit.xml'
                       }
					   
					    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  junit testResults: 'result-unit.xml', allowEmptyResults: true
					    }
					   
					    // (líneas 95/85, ramas 90/80)
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  cobertura coberturaReportFile: 'coverage.xml',
							onlyStable: false,
							lineCoverageTargets: '95,85,0',
							conditionalCoverageTargets: '90,80,0'
						}
                    }
					post { always { cleanWs() } }
                }

			    stage('Static (flake8)') {
                    agent { label 'agent1' }
                    steps {
                        deleteDir()
                        unstash 'code'
						
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
                                whoami
                                hostname
                                echo %WORKSPACE%
                                flake8 --exit-zero --format=pylint app 1>flake8.out
                                type flake8.out
                            '''
                        }
						
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  recordIssues tools: [flake8(pattern: 'flake8.out')], qualityGates: [
							[threshold: 8,  type: 'TOTAL', unstable: true],   // >=8 => UNSTABLE
							[threshold: 10, type: 'TOTAL', unstable: false]   // >=10 => FAIL/ROJO
						  ]
						}

                       // stash name: 'flake8-res', includes: 'flake8.out'
                    }
                    post { always { cleanWs() } }
                }
				
				stage('Security (Bandit)') {
                    agent { label 'agent1' }
                    steps {
                        deleteDir()
						unstash 'code'

                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
                                whoami
                                hostname
                                echo %WORKSPACE%
                                python -m bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: {severity}: {test_id}: {msg}"
                                type bandit.out
                            '''
                        }
						
						catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
						  recordIssues tools: [pyLint(pattern: 'bandit.out')], qualityGates: [
							[threshold: 2, type: 'TOTAL', unstable: true],   
							[threshold: 4, type: 'TOTAL', unstable: false]   
						  ]
						}

                        //stash name: 'bandit-res', includes: 'bandit.out'
                    }
                    post { always { cleanWs() } }
                }
				
				//stage('Generate Coverage') {
				//  steps {
				//	deleteDir()
				//	unstash 'code'
				//	catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
				//	  bat '''
				//		whoami
				//		hostname
				//		echo %WORKSPACE%
				//		set PYTHONPATH=%WORKSPACE%
				//		coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit
				//		coverage xml -o coverage.xml
				//		dir coverage.xml
				//	  '''
				//	}
				//	stash name: 'cov-res', includes: 'coverage.xml'
				//  }
				//  post { always { cleanWs() } }
				//}              
            }
        }
		//UBUNTU
		stage('Rest') {
		  agent {label 'agent2'}
		  steps {
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
				unstash name:'code'
				sh '''
					whoami
					hostname
					echo "${WORKSPACE}"
					. ~/venv/bin/activate

					export FLASK_APP=app/api.py                          
					python -m flask run &

					sleep 4

					java -jar /home/jenkins/wiremock/wiremock-standalone-3.3.1.jar --port 9090 --root-dir test/wiremock &
					export PYTHONPATH=${WORKSPACE}
					
					sleep 15
					
					python -m pytest --junitxml=result-rest.xml test/rest
				'''
			}
			  
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
				junit testResults: 'result-rest.xml', allowEmptyResults: true
			}
			  //stash name:'rest-res', includes:'result-rest.xml'
		  }  
		  post { always { cleanWs() } }			
		}

		stage('Performance (Jmeter)') {
		  agent { label 'agent2' }
		  steps {
			deleteDir()
			unstash 'code'
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
			  sh '''
				whoami
				hostname
				echo "${WORKSPACE}"
				. ~/venv/bin/activate

				export FLASK_APP=app/api.py
				python -m flask run &

				sleep 15
				JMETER=/opt/apache-jmeter-5.6.3/bin/jmeter
				"$JMETER" -n -t test/jmeter/flask.jmx -l flask.jtl -j jmeter.log
			  '''
			}
			catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
              perfReport sourceDataFiles: 'flask.jtl'
            }
			//stash name: 'perf-res', includes: 'flask.jtl,jmeter.log'
		  }
		  post { always { cleanWs() } }
		}
    }
}